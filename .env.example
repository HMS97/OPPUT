# EODHD API Key
# Get from https://eodhd.com/register (free tier available)
EODHD_API_KEY=your_api_key_here

# Robinhood Credentials
# For automated trading via robin_stocks library
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password
ROBINHOOD_MFA_CODE=optional_totp_secret

# Risk Limits (optional, has defaults)
MAX_DAILY_TRADES=3
MAX_POSITION_SIZE=500
MAX_DAILY_LOSS=300

# Robinhood API Port
ROBINHOOD_API_PORT=8001
